# CareOrbit - server-side integrations.
#
# ALL OPTIONAL. With none of these set the site behaves exactly as v2-maven
# does today: forms validate, serve their download or open Calendly, and
# transmit nothing. Setting them turns on lead capture with no code change.
#
# None of these are NEXT_PUBLIC_. They are read only by modules that start
# with `import "server-only"`, so the build fails if a client component
# ever pulls one in.

# --- Public -----------------------------------------------------------------
# Drives every canonical URL and the sitemap. Confirmed at closeout as the
# intended production hostname; this is also the built-in default, so the
# variable only needs setting to point a preview build somewhere else.
NEXT_PUBLIC_SITE_URL=https://careorbit.com

# --- Supabase (lead storage) ------------------------------------------------
# Service-role key: server-side only, never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads

# --- Resend (lead notification email) ---------------------------------------
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=
